# =============================================================================
# Letting Partners Portal - environment
# Copy to .env.local for development. Never commit real secrets.
# =============================================================================

# --- DATABASE ---------------------------------------------------------------
# Any Postgres 14+ instance (Neon, Vercel Postgres, Supabase, RDS, local).
# Use the pooled connection string in production.
DATABASE_URL=postgres://user:password@host:5432/letting_partners

# Who the development seed makes the super admin.
SEED_ADMIN_EMAIL=admin@lettingpartners.co.uk

# --- AUTH -------------------------------------------------------------------
# 32+ random characters. Generate with:  openssl rand -base64 48
AUTH_SECRET=replace-with-a-long-random-string-at-least-32-chars
SESSION_TTL_HOURS=12
SESSION_REMEMBER_TTL_DAYS=30

# --- RESEND (OTP + transactional email) -------------------------------------
# Without a key, OTP codes are printed to the server log in development.
RESEND_API_KEY=
AUTH_FROM_EMAIL=Letting Partners <no-reply@lettingpartners.co.uk>

# --- PUBLIC WEBSITE INTEGRATION ---------------------------------------------
# Must match WEBSITE_API_KEY in the public website project. The website sends
# it as the x-website-api-key header when calling /api/website/*.
WEBSITE_API_KEY=replace-with-the-same-value-used-in-the-website

# --- URLS -------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=https://www.lettingpartners.co.uk
NEXT_PUBLIC_PORTAL_URL=https://portal.lettingpartners.co.uk
NEXT_PUBLIC_COMPANY_NAME=Letting Partners

# --- STORAGE (S3-compatible: Cloudflare R2, AWS S3, Backblaze B2) -----------
# R2: Cloudflare dashboard -> R2 -> your bucket -> Settings for the endpoint,
# and "Manage API tokens" for the key pair. Region is "auto" for R2.
S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
S3_BUCKET=lp-portal
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_REGION=auto
# How uploads are addressed publicly. Either a custom domain on the bucket, or
# the bucket's public development URL (R2 -> Settings -> Public access).
# Without this, uploaded photos are not viewable and listings cannot publish.
S3_PUBLIC_BASE_URL=

# Fallback, used only when the S3 variables above are not set.
BLOB_READ_WRITE_TOKEN=

# --- AI IMAGE ALT TEXT (optional) -------------------------------------------
# none = deterministic alt text generated from property data (no external call).
ALT_TEXT_PROVIDER=none
ANTHROPIC_API_KEY=
ALT_TEXT_MODEL=claude-sonnet-5
